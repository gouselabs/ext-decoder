---
// Shared logomark: a rounded badge with a "< >" bracket glyph, used in the
// header, footer, and as the site favicon (public/favicon.svg — keep both
// in sync if this design changes).
interface Props {
  size?: number;
}
const { size = 28 } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 40 40"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label="Ext Decoder logo"
  class="logo-mark"
>
  <rect width="40" height="40" rx="10" fill="#3056f5" />
  <g fill="none" stroke="#ffffff" stroke-width="3.1" stroke-linecap="round" stroke-linejoin="round">
    <polyline points="16 11 8 20 16 29" />
    <polyline points="24 11 32 20 24 29" />
  </g>
</svg>
