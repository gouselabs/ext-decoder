---
import type { FAQItem } from "../lib/types";

interface Props {
  items: FAQItem[];
}

const { items } = Astro.props;
---

<section class="section" aria-labelledby="faq-heading">
  <h2 id="faq-heading">Frequently asked questions</h2>
  {items.map((item) => (
    <div class="faq-item">
      <h3>{item.question}</h3>
      <p>{item.answer}</p>
    </div>
  ))}
</section>
