---
import { SITE } from "../config/site";

const year = new Date().getFullYear();

const FOOTER_LINKS = [
  { href: "/faq/", label: "FAQ" },
  { href: "/about/", label: "About Us" },
  { href: "/contact/", label: "Contact Us" },
  { href: "/privacy-policy/", label: "Privacy Policy" },
  { href: "/terms/", label: "Terms & Conditions" },
];
---

<footer class="global-footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <a href="/" class="brand-mark">
        <span class="brand-mark-dot" aria-hidden="true"></span>
        {SITE.brandMark}
      </a>
      <p>{SITE.tagline}. Runs entirely in your browser — no upload, no sign-up, no tracking.</p>
    </div>

    <nav class="footer-links" aria-label="Footer">
      {FOOTER_LINKS.map((link) => (
        <a href={link.href}>{link.label}</a>
      ))}
    </nav>

    <p class="footer-legal">
      &copy; {year} {SITE.name}. A <a href={SITE.parentUrl}>{SITE.parentBrand}</a> project. Not affiliated with any
      software vendor mentioned on this site.
    </p>
  </div>
</footer>
